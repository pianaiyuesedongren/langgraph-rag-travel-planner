APP_ENV=local
APP_NAME=Gaode Travel Planner

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1600
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
REDIS_ENABLED=true
REDIS_CACHE_TTL=3600
REDIS_EVENT_TTL=86400

DATABASE_ENABLED=false
DATABASE_URL=postgresql+asyncpg://gaode:gaode@127.0.0.1:5432/gaode
CHECKPOINT_BACKEND=memory
CHECKPOINT_DATABASE_URL=postgresql://gaode:gaode@127.0.0.1:5432/gaode
POSTGRES_DB=gaode
POSTGRES_USER=gaode
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_AUTO_CREATE=false

LLM_API_KEY=replace-with-your-tokenplan-key
AMAP_MAPS_API_KEY=replace-with-your-amap-key

EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
VECTOR_STORE_ENABLED=true
USE_REMOTE_EMBEDDINGS=true
USE_LLM_SUPERVISOR=true
USE_REACT_AGENTS=true
USE_LLM_ITINERARY=true
AGENT_TIMEOUT_SECONDS=120
